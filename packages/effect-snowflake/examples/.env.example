# Copy to packages/effect-snowflake/.env. Real .env files are ignored by Git.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USERNAME=example_user
SNOWFLAKE_DATABASE=EXAMPLE_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=EXAMPLE_WH
SNOWFLAKE_AUTHENTICATOR=auth_jwt
# Choose an existing key file, or supply inline PKCS#8 PEM with SNOWFLAKE_PRIVATE_KEY.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASS=encrypted-key-passphrase
# SNOWFLAKE_ROLE=EXAMPLE_ROLE
# SNOWFLAKE_ADBC_DRIVER=/absolute/path/to/libadbc_driver_snowflake.so
# For password authentication use auth_snowflake and SNOWFLAKE_PASSWORD.
# For OAuth use auth_oauth and SNOWFLAKE_TOKEN.
# The live E2E suite contacts Snowflake only when this is 1.
SNOWFLAKE_E2E=0
