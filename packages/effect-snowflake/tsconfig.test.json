{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect", "@effect/*"],
        "allowedUnstableApis": ["@effect/vitest"]
      }
    ],
    "lib": ["ES2024"]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
