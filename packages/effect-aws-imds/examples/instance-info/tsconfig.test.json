{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2024"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect", "@effect/*"],
        "allowedUnstableApis": ["effect/http/FetchHttpClient"]
      }
    ]
  },
  "include": ["src", "e2e/**/*.ts", "vitest.config.ts"]
}
