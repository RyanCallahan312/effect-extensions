{
  "name": "@rc312/effect-aws-imds",
  "version": "0.1.0",
  "description": "Effect-native client for the AWS EC2 Instance Metadata Service (IMDSv2).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanCallahan312/effect-extensions.git",
    "directory": "packages/effect-aws-imds"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsc -b tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile .cache/typecheck.tsbuildinfo && tsc -p tsconfig.test.json",
    "test": "vitest run && node --test test/*.test.mjs",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.5",
    "@types/node": "^26.6.5",
    "effect": "^4.0.5",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
